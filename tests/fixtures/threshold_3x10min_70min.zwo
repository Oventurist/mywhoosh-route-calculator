<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Athlete OS</author>
    <name>threshold_3x10min_70min</name>
    <description>Threshold: 3 x 10min @ 95% FTP / 5min @ 50%. Total 70min.</description>
    <sportType>bike</sportType>
    <tags>threshold</tags>
    <workout>
        <Warmup Duration="900" PowerLow="0.45" PowerHigh="0.65" />
        <IntervalsT Repeat="3" OnDuration="600" OffDuration="300" OnPower="0.95" OffPower="0.50" />
        <Cooldown Duration="600" PowerLow="0.55" PowerHigh="0.40" />
    </workout>
</workout_file>