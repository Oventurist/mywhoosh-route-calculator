<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Athlete OS</author>
    <name>threshold_pyramid_50min</name>
    <description>Variable intervals: 8min@88%, 8min@92%, 8min@96%, 8min@92%. Total 69min.</description>
    <sportType>bike</sportType>
    <tags>threshold,custom</tags>
    <workout>
        <Warmup Duration="900" PowerLow="0.45" PowerHigh="0.65" />
        <SteadyState Duration="480" Power="0.88" />
        <SteadyState Duration="240" Power="0.50" />
        <SteadyState Duration="480" Power="0.92" />
        <SteadyState Duration="240" Power="0.50" />
        <SteadyState Duration="480" Power="0.96" />
        <SteadyState Duration="240" Power="0.50" />
        <SteadyState Duration="480" Power="0.92" />
        <Cooldown Duration="600" PowerLow="0.55" PowerHigh="0.40" />
    </workout>
</workout_file>