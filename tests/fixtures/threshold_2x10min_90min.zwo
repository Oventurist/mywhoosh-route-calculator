<?xml version='1.0' encoding='utf-8'?>
<workout_file>
    <author>Athlete OS</author>
    <name>threshold_2x10min_90min</name>
    <description>Threshold: 2 x 10min @ 95% FTP (148 W) / 5min @ 50%, plus 35min Z2 steady. Total 90min. Targets week 80/20: 20min Z4 + 70min Z1/Z2.</description>
    <sportType>bike</sportType>
    <tags>threshold</tags>
    <workout>
        <Warmup Duration="900" PowerLow="0.45" PowerHigh="0.65" />
        <IntervalsT Repeat="2" OnDuration="600" OffDuration="300" OnPower="0.95" OffPower="0.50" />
        <SteadyState Duration="2100" Power="0.65" />
        <Cooldown Duration="600" PowerLow="0.55" PowerHigh="0.40" />
    </workout>
</workout_file>
